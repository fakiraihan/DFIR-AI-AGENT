# DeepEval judge LLM via KoboILM OpenAI-compatible endpoint
OPENAI_API_KEY=your_koboillm_api_key
OPENAI_BASE_URL=https://api.koboillm.com/v1
OPENAI_MODEL_NAME=openai/gpt-5.4

# Optional aliases for scripts that prefer explicit KoboILM names.
KOBOILLM_API_KEY=your_koboillm_api_key
KOBOILLM_BASE_URL=https://api.koboillm.com/v1
KOBOILLM_MODEL=openai/gpt-5.4

