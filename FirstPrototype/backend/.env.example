# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=foundation-sec-8b

# Threat Intelligence API Keys
THREATFOX_API_KEY=your_threatfox_api_key
MALWAREBAZAAR_API_KEY=your_malwarebazaar_api_key
URLHAUS_API_KEY=your_urlhaus_api_key
ALIENVALUOT_OTX_API_KEY=your_otx_api_key
GREYNOISE_API_KEY=your_greynoise_api_key
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# Model Paths
DEEPLOG_MODEL_PATH=../models/deeplog/DeepLog.pt
DEEPLOG_VOCAB_PATH=../models/deeplog/DeepLog.pkl
DRAIN_CONFIG_PATH=../models/drain/drain_config.ini

# RSA Keys
RSA_PRIVATE_KEY_PATH=../keys/private.pem
RSA_PUBLIC_KEY_PATH=../keys/public.pem

# Application Settings
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=1000
SESSION_TIMEOUT_MINUTES=60
